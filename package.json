{
  "name": "omp-lm-studio-warm",
  "version": "0.1.0",
  "description": "Deterministic LM Studio model pre-warm gate for omp — loads and keeps the target model resident before every completion stream.",
  "type": "module",
  "license": "MIT",
  "author": "Diego Marino <diego@petalo.xyz>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/diegomarino/omp-lm-studio-warm.git"
  },
  "homepage": "https://github.com/diegomarino/omp-lm-studio-warm#readme",
  "bugs": {
    "url": "https://github.com/diegomarino/omp-lm-studio-warm/issues"
  },
  "engines": {
    "bun": ">=1.0.0"
  },
  "main": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "files": [
    "src",
    "examples",
    "demo-lm-studio-warm.cast",
    "docs/quickstart.gif",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "omp",
    "oh-my-pi",
    "lm-studio",
    "lmstudio",
    "prewarm",
    "local-llm"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "check": "bun run typecheck && bun run test",
    "demo:play": "asciinema play demo-lm-studio-warm.cast",
    "demo:cast": "python3 scripts/generate-quickstart-cast.py",
    "demo:gif": "python3 scripts/generate-quickstart-cast.py && agg --font-size 16 --last-frame-duration 8 demo-lm-studio-warm.cast docs/quickstart.gif && python3 scripts/add-progress-bar.py docs/quickstart.gif && gifsicle -O3 --colors 256 --batch docs/quickstart.gif",
    "demo:record": "bash ./scripts/record-demo.sh",
    "demo:record:cast": "bash ./scripts/record-demo.sh demo-console.cast"
  },
  "omp": {
    "extensions": ["./src/index.ts"]
  },
  "dependencies": {
    "yaml": "^2.8.0"
  },
  "overrides": {
    "adm-zip": ">=0.6.0",
    "sharp": ">=0.35.0"
  },
  "peerDependencies": {
    "@oh-my-pi/pi-ai": "^17.2.12",
    "@oh-my-pi/pi-coding-agent": "^17.2.12"
  },
  "peerDependenciesMeta": {
    "@oh-my-pi/pi-ai": {
      "optional": true
    },
    "@oh-my-pi/pi-coding-agent": {
      "optional": true
    }
  },
  "devDependencies": {
    "@oh-my-pi/pi-ai": "17.2.12",
    "@oh-my-pi/pi-coding-agent": "17.2.12",
    "@types/bun": "^1.3.14",
    "@types/node": "^22.15.0",
    "typescript": "^5.8.3"
  }
}
