{
  "name": "pi-lm-studio-warm",
  "version": "0.2.0",
  "description": "Deterministic LM Studio model pre-warm gate for pi — loads and keeps the target model resident before every completion stream.",
  "type": "module",
  "license": "MIT",
  "author": "Diego Marino <diego@petalo.xyz>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/diegomarino/lm-studio-warm.git",
    "directory": "packages/pi"
  },
  "homepage": "https://github.com/diegomarino/lm-studio-warm#readme",
  "bugs": {
    "url": "https://github.com/diegomarino/lm-studio-warm/issues"
  },
  "engines": {
    "bun": ">=1.0.0"
  },
  "main": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "files": [
    "src",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "pi",
    "earendil",
    "lm-studio",
    "lmstudio",
    "prewarm",
    "local-llm"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test --timeout 30000",
    "check": "bun run typecheck && bun run test"
  },
  "dependencies": {
    "lm-studio-warm-core": "^0.2.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=0.83.0 <1",
    "@earendil-works/pi-coding-agent": ">=0.83.0 <1"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.83.0",
    "@earendil-works/pi-coding-agent": "0.83.0",
    "@types/bun": "^1.3.14",
    "@types/node": "^22.15.0",
    "typescript": "^5.8.3"
  }
}
