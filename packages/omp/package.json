{
  "name": "omp-lm-studio-warm",
  "version": "0.2.2",
  "description": "Deterministic LM Studio model pre-warm gate for omp — loads and keeps the target model resident before every completion stream.",
  "type": "module",
  "license": "MIT",
  "author": "Diego Marino <diego@petalo.xyz>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/diegomarino/lm-studio-warm.git",
    "directory": "packages/omp"
  },
  "homepage": "https://github.com/diegomarino/lm-studio-warm#readme",
  "bugs": {
    "url": "https://github.com/diegomarino/lm-studio-warm/issues"
  },
  "engines": {
    "bun": ">=1.0.0"
  },
  "main": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "files": [
    "src",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "omp",
    "omp-plugin",
    "oh-my-pi",
    "lm-studio",
    "lmstudio",
    "prewarm",
    "local-llm"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test --timeout 30000",
    "test:watch": "bun test --watch",
    "check": "bun run typecheck && bun run test"
  },
  "omp": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "dependencies": {
    "lm-studio-warm-core": "^0.2.2"
  },
  "peerDependencies": {
    "@oh-my-pi/pi-ai": "^17.2.12",
    "@oh-my-pi/pi-coding-agent": "^17.2.12"
  },
  "peerDependenciesMeta": {
    "@oh-my-pi/pi-ai": {
      "optional": true
    },
    "@oh-my-pi/pi-coding-agent": {
      "optional": true
    }
  },
  "devDependencies": {
    "@oh-my-pi/pi-ai": "17.2.12",
    "@oh-my-pi/pi-coding-agent": "17.2.12",
    "@types/bun": "^1.3.14",
    "@types/node": "^22.15.0",
    "typescript": "^5.8.3"
  }
}
